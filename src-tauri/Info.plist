<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Voltius finds your other devices on this network so they can sync directly.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_voltius._tcp</string>
	</array>
	<!-- Web hosts (http://) open in a webview; without this macOS blocks plain-HTTP pages in a
	     release build. It applies to web content only, not to the app's own connections. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
